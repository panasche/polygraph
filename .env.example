# Polygraph Cloud - local development settings.
#
#   cp .env.example .env
#
# docker-compose.yml reads this file. Every value below is safe to share: it
# only works on your machine. Never put a real secret in this file or commit
# .env (it is gitignored). Staging and production get their values from AWS
# Secrets Manager (see infra/README.md).
#
# The variables follow docs/CONTRACTS.md section 6.

# --- Core --------------------------------------------------------------------
# development | staging | production. "development" enables POST /api/auth/dev-login
# and dev-only defaults for SESSION_SECRET and TOKEN_ENCRYPTION_KEY.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Inside compose the API uses the postgres service. Outside compose (no Docker),
# use SQLite instead: DATABASE_URL=sqlite:///./.data/dev.db
POSTGRES_USER=polygraph
POSTGRES_PASSWORD=polygraph-local-only
POSTGRES_DB=polygraph
DATABASE_URL=postgresql+psycopg://polygraph:polygraph-local-only@localhost:5432/polygraph

# --- Storage -----------------------------------------------------------------
# s3 | local. Compose runs an S3-compatible server on :8333.
STORAGE_BACKEND=s3
S3_BUCKET=polygraph-results
S3_ENDPOINT_URL=http://localhost:8333
LOCAL_STORAGE_DIR=./.data
# Credentials for the local S3 server only (see infra/local/s3.json).
LOCAL_S3_ACCESS_KEY=local-dev-access-key
LOCAL_S3_SECRET_KEY=local-dev-insecure-secret-key
# Leave empty locally (the local S3 server has no KMS). Required in production.
KMS_KEY_ID=

# --- Queue -------------------------------------------------------------------
# sqs | inline. Compose runs ElasticMQ (SQS-compatible) on :9324.
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=http://localhost:9324/000000000000/polygraph-uploads
SQS_ENDPOINT_URL=http://localhost:9324

# --- GitHub App --------------------------------------------------------------
# Optional locally: use POST /api/auth/dev-login instead of real sign-in.
# To test real sign-in, create a separate *development* GitHub App
# (read-only Metadata permission, no email) and fill these in your .env only.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents on one line with \n escapes, or leave empty.
GITHUB_APP_PRIVATE_KEY=

# --- App secrets -------------------------------------------------------------
# Leave empty in development: the API fills in clearly marked dev-only values
# and refuses to start with them anywhere else.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Uploads and content -----------------------------------------------------
OIDC_AUDIENCE=https://polygraphmcp.dev
LEADERBOARD_PROJECT=polygraph-dev/benchmark
PRIVACY_VERSION=2026-10-13
# presidio | regex. regex needs no extra install; production uses presidio.
PII_SCANNER=regex
LOG_LEVEL=INFO

# --- Web ---------------------------------------------------------------------
# Where the Next.js server reaches the API. Compose sets http://api:8000 itself.
API_ORIGIN=http://localhost:8000
# Slug of the GitHub App (github.com/apps/<slug>), used by the web app for install links.
GITHUB_APP_SLUG=
# Where the hosted service runs, quoted by the privacy notice and footer:
# aws-mumbai | oracle-mumbai | oracle-hyderabad.
HOSTING=aws-mumbai
